<launch>
    <!-- Scenario 3: Three drones follow independent waypoint sequences.
         Tests: different trajectory shapes, asynchronous timing, path crossing.
         Uses PositionCommand via position_cmd topic (bypasses init offset). -->
    <arg name="wait_for_start_signal" default="true"/>
    <arg name="start_topic" default="/start_waypoint_mission"/>
    <arg name="init_z_0" default="0.0"/>
    <arg name="init_z_1" default="0.0"/>
    <arg name="init_z_2" default="0.0"/>

    <include file="$(find test_interface)/launch/triple_drone_mid360.launch">
        <arg name="init_z_0" value="$(arg init_z_0)"/>
        <arg name="init_z_1" value="$(arg init_z_1)"/>
        <arg name="init_z_2" value="$(arg init_z_2)"/>
        <!-- Connect each drone's position_cmd to the waypoint publisher -->
        <arg name="position_cmd_topic_0" value="/quad_0/planning/pos_cmd"/>
        <arg name="position_cmd_topic_1" value="/quad_1/planning/pos_cmd"/>
        <arg name="position_cmd_topic_2" value="/quad_2/planning/pos_cmd"/>
        <arg name="wait_for_start_signal" value="$(arg wait_for_start_signal)"/>
        <arg name="start_topic" value="$(arg start_topic)"/>
    </include>

    <node pkg="test_interface"
          type="triple_waypoint_mission_publisher.py"
          name="waypoint_mission_publisher"
          output="screen">
        <param name="frame_id" value="world"/>
        <param name="rate_hz" value="20.0"/>
        <param name="start_delay" value="3.0"/>
        <param name="wait_for_start_signal" value="$(arg wait_for_start_signal)"/>
        <param name="start_topic" value="$(arg start_topic)"/>
        <param name="publish_yaw_tangent" value="true"/>
        <param name="segment_duration" value="4.0"/>
        <param name="dwell_duration" value="0.5"/>
        <param name="loop_mission" value="true"/>
        <param name="smooth_profile" value="true"/>
        <param name="min_pair_distance" value="1.5"/>
        <!-- Stagger starts to create temporal diversity -->
        <param name="time_offset_uav0" value="0.0"/>
        <param name="time_offset_uav1" value="1.5"/>
        <param name="time_offset_uav2" value="3.0"/>
        <!-- Waypoints designed so paths cross in the middle area -->
        <param name="waypoints_uav0" value="[[0.0, 0.0, 1.2], [4.0, 4.0, 1.2], [-2.0, 3.0, 1.2], [3.0, -1.0, 1.2], [-3.0, -3.0, 1.2], [1.0, 2.0, 1.2], [0.0, 0.0, 1.2]]"/>
        <param name="waypoints_uav1" value="[[-3.0, 0.0, 1.5], [1.0, -4.0, 1.5], [4.0, 1.0, 1.5], [-1.0, 3.0, 1.5], [2.0, -2.0, 1.5], [-4.0, 2.0, 1.5], [-3.0, 0.0, 1.5]]"/>
        <param name="waypoints_uav2" value="[[-6.0, 1.2, 2.0], [-2.0, -3.0, 2.0], [2.0, 2.0, 2.0], [-4.0, 4.0, 2.0], [0.0, -1.0, 2.0], [-2.0, 3.0, 2.0], [-6.0, 1.2, 2.0]]"/>
    </node>
</launch>
