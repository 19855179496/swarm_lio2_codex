<launch>
    <!-- Scenario 2: Three drones fly back-and-forth diagonals.
         No start signal - cascadePID starts immediately, publisher uses time delay.
         All share /goal; cascadePID adds per-drone init offset automatically. -->
    <arg name="goal_rate_hz" default="30.0"/>
    <arg name="goal_period" default="12.0"/>
    <arg name="goal_start_delay" default="15.0"/>
    <arg name="init_z_0" default="0.0"/>
    <arg name="init_z_1" default="0.0"/>
    <arg name="init_z_2" default="0.0"/>

    <include file="$(find test_interface)/launch/triple_drone_mid360.launch">
        <arg name="init_z_0" value="$(arg init_z_0)"/>
        <arg name="init_z_1" value="$(arg init_z_1)"/>
        <arg name="init_z_2" value="$(arg init_z_2)"/>
        <arg name="position_cmd_topic_0" value="/disabled/quad_0/planning/pos_cmd"/>
        <arg name="position_cmd_topic_1" value="/disabled/quad_1/planning/pos_cmd"/>
        <arg name="position_cmd_topic_2" value="/disabled/quad_2/planning/pos_cmd"/>
        <arg name="wait_for_start_signal" value="false"/>
    </include>

    <node pkg="test_interface"
          type="triple_diagonal_goal_publisher.py"
          name="diagonal_goal_publisher"
          output="screen">
        <param name="frame_id" value="world"/>
        <param name="rate_hz" value="$(arg goal_rate_hz)"/>
        <param name="start_delay" value="$(arg goal_start_delay)"/>
        <param name="wait_for_start_signal" value="false"/>
        <param name="period" value="$(arg goal_period)"/>
        <param name="hold_z" value="0.0"/>
        <param name="topic0" value="/goal"/>
        <param name="topic1" value="/goal"/>
        <param name="topic2" value="/goal"/>
        <param name="A0" value="[-3.0, -3.0, 1.2]"/>
        <param name="B0" value="[3.0, 3.0, 1.2]"/>
        <param name="A1" value="[-3.0, -3.0, 1.2]"/>
        <param name="B1" value="[3.0, 3.0, 1.2]"/>
        <param name="A2" value="[-3.0, -3.0, 1.2]"/>
        <param name="B2" value="[3.0, 3.0, 1.2]"/>
    </node>
</launch>
